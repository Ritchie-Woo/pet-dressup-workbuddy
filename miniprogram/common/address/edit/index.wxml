<!-- common/address/edit/index.wxml — 新增/编辑收货地址 -->
<navbar title="{{isEdit ? '编辑地址' : '新增地址'}}" />

<view class="page-address-edit">
  <view class="form-section">
    <view class="form-row">
      <text class="label">收货人 <text class="required">*</text></text>
      <t-input value="{{form.receiverName}}" placeholder="请输入收货人姓名" bind:change="onFieldChange" data-field="receiverName" maxlength="{{16}}" />
    </view>
    <view class="form-row">
      <text class="label">手机号 <text class="required">*</text></text>
      <t-input value="{{form.phone}}" type="number" placeholder="请输入手机号" bind:change="onFieldChange" data-field="phone" maxlength="{{11}}" />
    </view>
    <view class="form-row">
      <text class="label">所在地区</text>
      <view class="picker-wrap">
        <picker mode="region" value="{{[form.province, form.city, form.district]}}" bindchange="onRegionChange">
          <view class="picker-placeholder">{{regionText || '请选择省市区'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-row">
      <text class="label">详细地址 <text class="required">*</text></text>
      <t-input value="{{form.detail}}" placeholder="街道、门牌号等" bind:change="onFieldChange" data-field="detail" maxlength="{{100}}" />
    </view>
    <view class="form-row">
      <t-cell title="设为默认地址" rightIcon="{{form.isDefault ? 'check-circle-filled' : 'circle'}}" bind:tap="toggleDefault" />
    </view>
  </view>

  <view class="btn-area safe-bottom">
    <t-button theme="primary" size="large" block bindtap="handleSave" loading="{{saving}}">保存</t-button>
  </view>
</view>
