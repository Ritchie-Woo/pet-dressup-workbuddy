<!-- common/pet/list/index.wxml — 宠物列表 -->
<navbar title="我的宠物" />

<scroll-view class="page-pet-list" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 空状态 -->
  <view wx:if="{{!loading && pets.length === 0}}" class="empty-wrap">
    <empty-state icon="pet" text="还没有宠物，快来创建一只吧">
      <t-button theme="primary" size="medium" bindtap="goCreate">添加宠物</t-button>
    </empty-state>
  </view>

  <!-- 骨架屏 -->
  <view wx:elif="{{loading}}" class="skeleton-wrap">
    <skeleton row="{{3}}" />
  </view>

  <!-- 宠物列表 -->
  <view wx:else class="pet-list">
    <view wx:for="{{pets}}" wx:key="petId" class="pet-card {{item.gender === 'male' ? 'card-male' : 'card-female'}}">
      <!-- 左侧头像 -->
      <view class="pet-avatar-wrap">
        <image class="pet-avatar" src="{{item.avatarUrl || '/images/default-pet.png'}}" mode="aspectFill" lazy-load />
      </view>

      <!-- 右侧信息区域 -->
      <view class="pet-info">
        <view class="info-top">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-breed-tag">{{item.breed || item.species || '未知'}}</text>
        </view>
        <view class="info-bottom">
          <text class="info-item">
            <text class="info-dot">●</text> {{item.species === 'dog' ? '狗狗' : item.species === 'cat' ? '猫咪' : item.species || '—'}}
          </text>
          <text class="info-divider">|</text>
          <text class="info-item">
            <text class="info-dot">●</text> {{item.birthday || '—'}}
          </text>
        </view>
      </view>

      <!-- 右侧箭头（唯一点击区域） -->
      <view class="pet-arrow-circle" catchtap="goDetail" data-id="{{item.petId}}">
        <t-icon name="chevron-right" size="28rpx" color="#A09080" />
      </view>
    </view>

    <!-- 添加按钮 -->
    <view class="add-pet" bindtap="goCreate">
      <t-icon name="add" size="48rpx" color="#FF8C00" />
      <text class="add-text">添加宠物</text>
    </view>
  </view>
</scroll-view>
