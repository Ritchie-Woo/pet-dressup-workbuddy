<!-- my/index.wxml — Airbnb Design System -->
<view class="page-brandbar">
  <text class="brand-text">PetMini</text>
</view>

<view class="pg-my">
  <!-- VIP 会员卡片 -->
  <view class="my-vip-card">
    <view class="vip-card-top">
      <view class="vip-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="vip-avatar-placeholder">🐾</text>
      </view>
      <view class="vip-info">
        <text class="vip-name" wx:if="{{userInfo.nickname}}">{{userInfo.nickname}}</text>
        <text class="vip-name" wx:else>未登录</text>
        <view class="vip-badge">
          <text class="vip-crown">👑</text>
          <text class="vip-label">PetMini 会员</text>
        </view>
      </view>
    </view>
    <view class="vip-benefits">
      <view class="benefit-item">
        <text class="benefit-icon">🎁</text>
        <text class="benefit-text">专属优惠</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">⚡</text>
        <text class="benefit-text">优先发货</text>
      </view>
      <view class="benefit-item">
        <text class="benefit-icon">💎</text>
        <text class="benefit-text">积分翻倍</text>
      </view>
    </view>
  </view>

  <!-- Menu -->
  <view class="my-menu">
    <view class="menu-item" catchtap="goPetList">
      <text class="menu-icon">🐶</text>
      <text class="menu-label">我的宠物</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 支付功能隐藏：收货地址 -->
    <!-- <view class="menu-item" catchtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-label">收货地址</text>
      <text class="menu-arrow">›</text>
    </view> -->
    <!-- 支付功能隐藏：我的订单 -->
    <!-- <view class="menu-item" catchtap="goOrders">
      <text class="menu-icon">📦</text>
      <text class="menu-label">我的订单</text>
      <text class="menu-arrow">›</text>
    </view> -->
  </view>

  <view class="my-menu" style="margin-top:16rpx;">
    <view class="menu-item" catchtap="switchAccount">
      <text class="menu-icon">🔄</text>
      <text class="menu-label">切换账号</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-label">关于 PetMini</text>
      <text class="menu-note">v1.0.0</text>
    </view>
  </view>

  <view class="my-footer">
    <text class="footer-text">PetMini · Airbnb Design</text>
  </view>
</view>
