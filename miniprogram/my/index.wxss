/* my/index.wxss — Airbnb */

.pg-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  background: var(--bg);
  border-bottom: 1rpx solid var(--bg-tertiary);
}

.toolbar-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text);
}

.pg-my {
  min-height: calc(100vh - 130rpx);
  background: var(--body-bg);
}

.my-user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 32rpx;
  background: var(--bg);
  margin: 24rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--bg-tertiary);
}

.my-avatar-empty {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-lighter);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.my-name {
  font-size: var(--font-xl);
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.5rpx;
}

.my-menu {
  margin: 0 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--bg-tertiary);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-secondary);
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; width: 48rpx; text-align: center; }

.menu-label {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text);
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--bg-tertiary);
  font-weight: 300;
}

.menu-note {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.my-footer {
  text-align: center;
  padding: 48rpx 0;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}
