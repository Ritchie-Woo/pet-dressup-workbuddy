/* my/index.wxss — Airbnb */

.pg-my {
  min-height: 100vh;
  background: var(--body-bg);
}

/* ===== VIP 会员卡片 ===== */
.my-vip-card {
  margin: 24rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.1);
  background: linear-gradient(135deg, #FFF8E1, #FFE0B2, #FFCC80);
}

.vip-card-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 32rpx 24rpx;
}

.vip-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.8);
  overflow: hidden;
  flex-shrink: 0;
  background: #FFD54F;
}

.vip-avatar image {
  width: 100%;
  height: 100%;
}

.vip-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: rgba(255,255,255,.4);
}

.vip-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.vip-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #4E342E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 6rpx;
  background: rgba(255,255,255,.85);
  backdrop-filter: blur(10px);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.vip-crown {
  font-size: 26rpx;
}

.vip-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #E65100;
}

/* 会员权益 */
.vip-benefits {
  display: flex;
  justify-content: space-around;
  background: rgba(255,255,255,.5);
  padding: 20rpx 16rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.benefit-icon {
  font-size: 36rpx;
}

.benefit-text {
  font-size: 22rpx;
  color: #6D4C41;
  font-weight: 500;
}

.my-menu {
  margin: 0 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--bg-tertiary);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-secondary);
}

.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; width: 48rpx; text-align: center; }

.menu-label {
  flex: 1;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text);
}

.menu-arrow {
  font-size: var(--font-lg);
  color: var(--bg-tertiary);
  font-weight: 300;
}

.menu-note {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.my-footer {
  text-align: center;
  padding: 48rpx 0;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

/* 团长入口 */
.leader-entry {
  background: linear-gradient(135deg, #FFF8E1, #FFE0B2);
  border-radius: var(--radius);
}

.menu-label-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
}
