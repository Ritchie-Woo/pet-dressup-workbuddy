/* gb/order/list/index.wxss — 订单列表页样式 */

.order-list-page {
  min-height: 100vh;
  background: var(--body-bg, #F5F5F5);
  display: flex;
  flex-direction: column;
}

/* 品牌顶栏 */
.order-brandbar {
  padding: 20rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  background: #FFFFFF;
  flex-shrink: 0;
}
.brandbar-has-back { display: flex; align-items: center; justify-content: center; position: relative; }
.brandbar-back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; }
.brandbar-back:active { opacity: 0.5; }
.brandbar-spacer { width: 60rpx; }

/* Tab 容器 */
.tabs-wrapper {
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
  flex-shrink: 0;
}

/* 订单滚动区 */
.order-scroll {
  flex: 1;
  padding: 0 24rpx;
}

/* 订单卡片 */
.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-no {
  font-size: 24rpx;
  color: #B0B0B0;
}

/* 订单主体 */
.order-body {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}

.order-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.order-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.4;
}

.order-spec {
  font-size: 24rpx;
  color: #B0B0B0;
  margin-top: 8rpx;
}

.order-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: auto;
}

.order-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF5A5F;
}

.order-qty {
  font-size: 24rpx;
  color: #B0B0B0;
}

/* 操作按钮区 */
.order-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
  border-top: 1rpx solid #F5F5F5;
  padding-top: 20rpx;
}

/* 空状态 */
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.empty-desc {
  font-size: 26rpx;
  color: #B0B0B0;
}

.empty-btn {
  margin-top: 16rpx;
}

/* 加载骨架 */
.loading-wrap {
  padding: 24rpx;
}

/* 底部占位 */
.bottom-placeholder {
  height: 40rpx;
}
