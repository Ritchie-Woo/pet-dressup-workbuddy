<!-- gb/order/list/index.wxml — 订单列表 -->
<view class="order-list-page">
  <!-- 品牌顶栏 -->
  <view class="order-brandbar brandbar-has-back">
    <view class="brandbar-back" bindtap="goBack">
      <t-icon name="chevron-left" size="40rpx" color="#333" />
    </view>
    <text class="brand-text">PetMini</text>
    <view class="brandbar-spacer"></view>
  </view>
  <!-- 状态筛选 Tab -->
  <view class="tabs-wrapper">
    <t-tabs value="{{activeTab}}" bind:change="switchTab" space="{{false}}">
      <t-tab-panel wx:for="{{statusTabs}}" wx:key="value" label="{{item.label}}" value="{{item.value}}" />
    </t-tabs>
  </view>

  <!-- 有数据 -->
  <scroll-view wx:if="{{!loading && orders.length > 0}}" class="order-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{orders}}" wx:key="orderId" class="order-card" bindtap="goDetail" data-id="{{item.orderId}}">
      <!-- 卡片头部 -->
      <view class="order-header">
        <view class="header-left">
          <text class="order-no">订单号: {{item.orderId}}</text>
        </view>
        <t-tag
          size="small"
          variant="light"
          theme="{{statusTheme(item.status)}}"
        >{{statusLabel(item.status)}}</t-tag>
      </view>

      <!-- 卡片主体 -->
      <view class="order-body">
        <image class="order-thumb" src="{{item.productThumbnail || ''}}" mode="aspectFill" />
        <view class="order-info">
          <text class="order-name text-ellipsis-2">{{item.productName}}</text>
          <text class="order-spec" wx:if="{{item.specChoiceText}}">{{item.specChoiceText}}</text>
          <view class="order-bottom-row">
            <text class="order-price">¥{{item.amountTotal}}</text>
            <text class="order-qty">×{{item.quantity}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-footer" wx:if="{{item.status === 'pending' || item.status === 'shipped'}}">
        <t-button wx:if="{{item.status === 'pending'}}" theme="primary" size="small" catchtap="goPay" data-id="{{item.orderId}}">去支付</t-button>
        <t-button wx:if="{{item.status === 'shipped'}}" theme="default" size="small" variant="outline" catchtap="goDetail" data-id="{{item.orderId}}">查看物流</t-button>
      </view>
    </view>

    <view class="bottom-placeholder" />
  </scroll-view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && orders.length === 0}}" class="empty-wrap">
    <view class="empty-content">
      <t-icon name="order" size="120rpx" color="#D9D9D9" />
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">快去挑选心仪的宠物用品吧</text>
      <t-button theme="primary" size="medium" bindtap="goShop" class="empty-btn">去商城逛逛</t-button>
    </view>
  </view>

  <!-- 加载骨架 -->
  <view wx:else class="loading-wrap">
    <skeleton row="{{3}}" />
  </view>
</view>
