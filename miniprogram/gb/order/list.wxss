/* gb/order/list.wxss */

.order-page {
  height: 100vh;
  padding-top: calc(env(safe-area-inset-top));
  background: var(--body-bg);
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: var(--bg);
  padding: 8rpx 16rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  position: relative;
  font-weight: 500;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary);
}

/* 订单列表区 */
.order-list {
  padding: 16rpx 20rpx;
}

/* 订单卡片 */
.order-card {
  background: var(--bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 16rpx;
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 0;
}

.order-shop {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

.order-status.grouping { color: #FF5A5F; background: #FFF0F0; }
.order-status.paid { color: #0052D9; background: #E0EBFF; }
.order-status.shipped { color: #00A699; background: #E0FFF8; }
.order-status.completed { color: #999; background: #F5F5F5; }

/* 商品行 */
.order-product {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--td-bg-color-page);
}

.order-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--td-bg-color-page);
}

.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-left: 20rpx;
}

.order-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--td-text-color-primary);
  line-height: 1.4;
  max-height: 76rpx;
}

.order-spec {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
  margin-top: 6rpx;
}

.order-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.order-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}

.order-qty {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

/* 底部按钮区 */
.order-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.order-total {
  font-size: 24rpx;
  color: var(--td-text-color-secondary);
}

.total-highlight {
  font-weight: 600;
  color: var(--td-text-color-primary);
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.btn-share {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.btn-confirm {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--primary);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.scroll-bottom {
  height: 80rpx;
}

/* 空状态 */
.order-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}
