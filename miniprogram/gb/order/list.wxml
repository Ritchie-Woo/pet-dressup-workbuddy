<!-- gb/order/list.wxml — 订单列表 -->
<scroll-view class="order-page" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- Tab 筛选（始终显示，跟随滚动） -->
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab" data-key="{{item.key}}">{{item.label}}</view>
  </view>

  <!-- 有订单 -->
  <view wx:if="{{filteredOrders.length > 0}}" class="order-list">
    <view wx:for="{{filteredOrders}}" wx:key="orderId" class="order-card"
      bindtap="goDetail" data-id="{{item.orderId}}">
      <view class="order-header">
        <text class="order-shop">宠物帮购</text>
        <view class="order-status {{item.status}}">{{statusLabel(item.status)}}</view>
      </view>
      <view class="order-product">
        <image class="order-thumb" src="{{item.thumbnail || '/images/placeholder.png'}}" mode="aspectFill" />
        <view class="order-info">
          <text class="order-name text-ellipsis-2">{{item.name}}</text>
          <text class="order-spec" wx:if="{{item.specText}}">{{item.specText}}</text>
          <view class="order-bottom">
            <text class="order-price">¥{{item.amount}}</text>
            <text class="order-qty">×{{item.quantity || 1}}</text>
          </view>
        </view>
      </view>
      <view class="order-actions">
        <text class="order-total">共{{item.quantity || 1}}件 合计：<text class="total-highlight">¥{{item.amount}}</text></text>
        <view class="action-btns">
          <view wx:if="{{item.status === 'grouping'}}" class="btn-share" catchtap="goDetail" data-id="{{item.orderId}}">邀请拼团</view>
          <view wx:if="{{item.status === 'shipped'}}" class="btn-confirm" catchtap="confirmReceive" data-id="{{item.orderId}}">确认收货</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="order-empty">
    <t-empty icon="order" description="暂无订单">
      <t-button theme="primary" size="medium" bindtap="goShopping">去逛逛</t-button>
    </t-empty>
  </view>

  <view class="scroll-bottom"></view>
</scroll-view>
