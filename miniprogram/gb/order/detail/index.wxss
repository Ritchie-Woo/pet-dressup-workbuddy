/* gb/order/detail/index.wxss — 订单详情页样式 */

.detail-page {
  height: 100vh;
  background: var(--body-bg, #F5F5F5);
  box-sizing: border-box;
}

/* ===== 支付成功头部 ===== */
.success-header {
  background: linear-gradient(180deg, #E8F8F6 0%, #FFFFFF 100%);
  padding: 48rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  margin-bottom: 20rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #00A699;
  margin-bottom: 12rpx;
}

.success-price {
  font-size: 56rpx;
  font-weight: 800;
  color: #222222;
  margin-bottom: 24rpx;
}

.success-bonus {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 32rpx;
}

.bonus-text {
  font-size: 26rpx;
  color: #FF8F1F;
  font-weight: 500;
}

.success-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.success-actions .t-button {
  flex: 1;
}

/* ===== 订单状态卡片 ===== */
.status-card {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.status-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-desc {
  font-size: 26rpx;
  color: #717171;
}

/* ===== 物流时间线 ===== */
.timeline-card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  display: block;
  margin-bottom: 24rpx;
}

.timeline {
  position: relative;
}

.tl-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding-bottom: 28rpx;
  position: relative;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-item::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #EBEBEB;
}

.tl-item:last-child::after {
  display: none;
}

.tl-item.active::after {
  background: #00A699;
}

.tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #EBEBEB;
  flex-shrink: 0;
  margin-top: 4rpx;
  z-index: 1;
}

.tl-item.active .tl-dot {
  background: #00A699;
  box-shadow: 0 0 0 6rpx rgba(0, 166, 153, 0.15);
}

.tl-content {
  flex: 1;
}

.tl-label {
  font-size: 28rpx;
  color: #B0B0B0;
  display: block;
}

.tl-item.active .tl-label {
  color: #222222;
  font-weight: 600;
}

.tl-time {
  font-size: 24rpx;
  color: #B0B0B0;
  display: block;
  margin-top: 4rpx;
}

/* ===== 商品卡片 ===== */
.product-card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

.product-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.4;
}

.product-spec {
  font-size: 24rpx;
  color: #B0B0B0;
  margin-top: 8rpx;
}

.product-detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-label {
  font-size: 26rpx;
  color: #717171;
}

.detail-value {
  font-size: 26rpx;
  color: #222222;
  font-weight: 500;
}

.detail-value.price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF5A5F;
}

.detail-value.tracking {
  color: #00A699;
}

.detail-value.order-id {
  font-size: 24rpx;
  color: #B0B0B0;
}

/* ===== 订单信息卡片 ===== */
.info-card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 24rpx;
  padding: 28rpx;
}

/* ===== 底部占位 ===== */
.bottom-placeholder {
  height: 60rpx;
}
