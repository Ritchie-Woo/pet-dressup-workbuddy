/* gb/cart/index.wxss — 购物车页面样式 */

.page-cart {
  height: 100vh;
  background: var(--body-bg);
  position: relative;
  overflow: hidden;
}

/* ===== 顶部标题栏（固定） ===== */
.cart-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-top: calc(env(safe-area-inset-top) + var(--spacing-md));
  background: var(--bg);
  z-index: 50;
}

.cart-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
}

.cart-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text);
}

.cart-manage {
  font-size: var(--font-sm);
  color: var(--primary);
  padding: 8rpx 16rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
}

/* ===== 商品滚动区 ===== */
.cart-scroll {
  height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 120rpx);
  padding-bottom: 140rpx;
}

.scroll-bottom {
  height: 20rpx;
}

/* ===== 滑动删除 - 外层包裹 ===== */
.cart-item-wrapper {
  position: relative;
  overflow: hidden;
  margin: 8rpx var(--spacing-sm);
}

/* 删除按钮（藏在后面） */
.item-delete-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 150rpx;
  height: 100%;
  background: #D54941;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
}

/* ===== 商品卡片 ===== */
.cart-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  position: relative;
  z-index: 1;
}

/* 选择框 */
.item-check {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: var(--spacing-sm);
  z-index: 2;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.check-circle.checked {
  border-color: var(--primary);
  background: var(--primary);
}

/* 商品图片 */
.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--bg-secondary);
}

/* 商品信息 */
.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-left: var(--spacing-sm);
  min-height: 160rpx;
}

.item-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
  max-height: 72rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--primary);
}

/* 数量控制器 */
.item-quantity {
  display: flex;
  align-items: center;
  gap: 0;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  border: 1rpx solid var(--bg-tertiary);
  transition: all 0.15s ease;
}

.qty-btn:first-child {
  border-radius: 12rpx 0 0 12rpx;
}

.qty-btn:last-child {
  border-radius: 0 12rpx 12rpx 0;
}

.qty-btn:active {
  background: var(--bg-tertiary);
}

.qty-btn.disabled {
  opacity: 0.35;
}

.qty-icon {
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
  line-height: 1;
}

.qty-input {
  width: 80rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border-top: 1rpx solid var(--bg-tertiary);
  border-bottom: 1rpx solid var(--bg-tertiary);
}

.qty-num {
  font-size: var(--font-md);
  color: var(--text);
  font-weight: 600;
}

/* ===== 底部结算栏（固定） ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-lg);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--spacing-sm));
  background: var(--bg);
  border-top: 1rpx solid var(--bg-tertiary);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 50;
}

.bottom-left {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.select-all-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

.bottom-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.total-wrap {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}
