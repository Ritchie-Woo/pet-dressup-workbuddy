.groupbuy-index {
  min-height: 100vh;
  background: var(--body-bg);
  padding: 0 24rpx 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin: 32rpx 0 20rpx;
  display: block;
}

/* 类型卡片 */
.type-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow);
}

.type-card.locked {
  opacity: 0.6;
}

.type-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.type-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.type-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.type-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.type-badge {
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 我已开团 */
.my-products {
  background: var(--bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.product-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--bg-secondary);
}

.product-row:last-child { border-bottom: none; }

.product-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--bg-secondary);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.product-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
}

.product-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
