/* 品牌栏 — 含返回键 */
.brandbar-has-back { display: flex; align-items: center; justify-content: center; position: relative; }
.brandbar-back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; }
.brandbar-back:active { opacity: 0.5; }
.brandbar-spacer { width: 60rpx; }

.product-edit-page {
  min-height: 100vh;
  background: var(--body-bg);
  padding: 0 24rpx 200rpx;
}

.form-section {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.form-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
  display: block;
}

.form-item { margin-bottom: 24rpx; }
.form-item:last-child { margin-bottom: 0; }

.form-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.category-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.category-tag {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text);
  background: var(--bg-secondary);
  border: 2rpx solid transparent;
}
.category-tag.active { background: var(--primary-light); color: var(--primary); border-color: var(--primary); font-weight: 600; }

.spec-list { margin-bottom: 20rpx; }
.spec-item { background: var(--bg-secondary); border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.spec-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.spec-delete { font-size: 24rpx; color: var(--primary); flex-shrink: 0; padding: 8rpx; }
.spec-options { display: flex; flex-wrap: wrap; gap: 8rpx; align-items: center; }
.spec-option-tag { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; background: var(--bg); border-radius: 20rpx; font-size: 22rpx; color: var(--text); }
.opt-delete { font-size: 24rpx; color: var(--text-secondary); padding: 0 4rpx; }
.spec-option-add { min-width: 160rpx; }

.submit-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 24rpx;
  background: var(--bg);
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,.05);
  z-index: 100;
}
