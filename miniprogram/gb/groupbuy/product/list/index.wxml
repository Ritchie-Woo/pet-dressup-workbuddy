<!-- gb/groupbuy/product/list — 我的商品列表 -->
<view class="page-brandbar brandbar-has-back">
  <view class="brandbar-back" bindtap="goBack">
    <t-icon name="chevron-left" size="40rpx" color="#333" />
  </view>
  <text class="brand-text">PetMini</text>
  <view class="brandbar-spacer"></view>
</view>

<view class="product-list-page">
  <view class="add-bar">
    <t-button theme="primary" size="large" block bindtap="goCreate">+ 新建商品</t-button>
  </view>

  <view class="product-list" wx:if="{{!loading && products.length > 0}}">
    <view class="product-card" wx:for="{{products}}" wx:key="productId">
      <view class="product-main" catchtap="goEdit" data-id="{{item.productId}}">
        <image class="product-thumb" src="{{item.thumbnail}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.priceGroup}}</text>
          <view class="product-meta">
            <text class="meta-item">库存 {{item.stock}}</text>
            <text class="meta-item">已售 {{item.soldCount}}</text>
          </view>
        </view>
      </view>
      <view class="product-actions">
        <text class="toggle-label">{{item.isActive ? '已上架' : '已下架'}}</text>
        <t-switch value="{{item.isActive}}" data-id="{{item.productId}}" bindchange="onToggle" />
      </view>
    </view>
  </view>

  <t-loading wx:if="{{loadingMore}}" theme="circular" size="48rpx" class="loading-wrap" />
  <t-loading wx:if="{{loading}}" theme="circular" size="48rpx" class="loading-wrap" />
  <t-empty wx:if="{{!loading && products.length === 0}}" description="还没有商品，快去创建吧" />
</view>
