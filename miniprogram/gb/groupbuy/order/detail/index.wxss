/* 品牌栏 — 含返回键 */
.brandbar-has-back { display: flex; align-items: center; justify-content: center; position: relative; }
.brandbar-back { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; }
.brandbar-back:active { opacity: 0.5; }
.brandbar-spacer { width: 60rpx; }

.order-detail-page { min-height: 100vh; background: var(--body-bg); padding: 0 24rpx 48rpx; }

.status-card { border-radius: var(--radius); padding: 32rpx 24rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.status-card.pending { background: #FFF3E0; }
.status-card.paid { background: #FFE5E3; }
.status-card.shipped { background: #E3F2FD; }
.status-card.completed { background: #E8F5E9; }
.status-card.refunded { background: #F5F5F5; }
.status-label { font-size: 32rpx; font-weight: 800; }
.status-card.pending .status-label { color: #E65100; }
.status-card.paid .status-label { color: var(--primary); }
.status-card.shipped .status-label { color: #1565C0; }
.status-card.completed .status-label { color: #2E7D32; }
.status-card.refunded .status-label { color: #757575; }
.status-desc { font-size: 24rpx; color: var(--text-secondary); }

.info-card { background: var(--bg); border-radius: var(--radius); padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow); }
.card-title { font-size: 28rpx; font-weight: 700; color: var(--text); margin-bottom: 16rpx; display: block; }

.addr-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 8rpx; }
.addr-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.addr-phone { font-size: 26rpx; color: var(--text-secondary); }
.addr-detail { font-size: 24rpx; color: var(--text-secondary); line-height: 1.6; }

.product-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.product-name { font-size: 26rpx; color: var(--text); font-weight: 600; }
.product-qty { font-size: 24rpx; color: var(--text-secondary); }

.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-top: 1rpx solid var(--bg-secondary); }
.detail-label { font-size: 24rpx; color: var(--text-secondary); }
.detail-value { font-size: 24rpx; color: var(--text); }
.detail-value.price { font-size: 28rpx; font-weight: 800; color: var(--primary); }

.ship-section { margin-top: 20rpx; }

/* 发货弹窗 */
.ship-popup { padding: 32rpx 24rpx 48rpx; }
.ship-title { font-size: 30rpx; font-weight: 700; color: var(--text); margin-bottom: 24rpx; display: block; }

.ship-methods { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.ship-method { padding: 24rpx; border-radius: var(--radius); background: var(--bg-secondary); border: 2rpx solid transparent; }
.ship-method.active { background: var(--primary-light); border-color: var(--primary); }
.method-title { font-size: 28rpx; font-weight: 600; color: var(--text); display: block; margin-bottom: 4rpx; }
.method-desc { font-size: 22rpx; color: var(--text-secondary); }

.form-group { margin-bottom: 20rpx; }
.form-label { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 12rpx; display: block; }
.picker-value { padding: 16rpx 24rpx; background: var(--bg-secondary); border-radius: 12rpx; font-size: 26rpx; color: var(--text); }
