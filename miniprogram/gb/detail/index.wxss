/* gb/detail/index.wxss */
.detail-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 140rpx;
}

/* 轮播 */
.swiper-wrap { position: relative; }
.detail-swiper { width: 100%; height: 560rpx; }
.swiper-img { width: 100%; height: 560rpx; background: var(--td-bg-color-page); }

.back-btn {
  position: absolute; top: calc(env(safe-area-inset-top) + 20rpx); left: 24rpx;
  width: 64rpx; height: 64rpx; border-radius: 50%; background: rgba(0,0,0,.35);
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; z-index: 10;
}

/* 信息 */
.info-card {
  background: #fff;
  margin: -36rpx 24rpx 16rpx;
  padding: 32rpx;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
}

.price-row {
  display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx;
}
.price-now { font-size: 48rpx; font-weight: 800; color: var(--primary); }
.price-old { font-size: 26rpx; color: #ccc; text-decoration: line-through; }
.tag-off {
  background: var(--primary-lighter); color: var(--primary);
  font-size: 22rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: var(--radius-pill);
}

.prod-name { font-size: 32rpx; font-weight: 700; color: var(--td-text-color-primary); margin-bottom: 6rpx; }
.prod-meta { font-size: 24rpx; color: var(--td-text-color-secondary); }

/* 规格 + 描述 */
.spec-card, .desc-card {
  background: #fff; margin: 0 24rpx 16rpx; padding: 24rpx; border-radius: var(--radius);
}
.sec-title { font-size: 28rpx; font-weight: 700; color: var(--td-text-color-primary); margin-bottom: 16rpx; display: block; }
.spec-group { margin-bottom: 12rpx; }
.spec-label { font-size: 24rpx; color: var(--td-text-color-secondary); margin-bottom: 10rpx; display: block; }
.spec-opts { display: flex; flex-wrap: wrap; gap: 14rpx; }
.spec-pill {
  padding: 12rpx 24rpx; border-radius: var(--radius-pill);
  background: var(--td-bg-color-page); font-size: 26rpx;
  color: var(--td-text-color-secondary); border: 2rpx solid transparent;
}
.spec-pill.active { background: var(--primary-lighter); border-color: var(--primary); color: var(--primary); font-weight: 700; }
.desc-text { font-size: 26rpx; color: var(--td-text-color-secondary); line-height: 1.8; }

/* 底部操作栏 — 拼团方案 */
.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06);
  padding-bottom: calc(env(safe-area-inset-bottom) + 4rpx);
  z-index: 50;
}

/* 已有拼团列表 */
.group-progress {
  padding: 16rpx 28rpx 0;
  border-bottom: 1rpx solid var(--td-bg-color-page);
}

.group-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.group-avatars {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.group-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  background: var(--td-bg-color-page);
  margin-left: -8rpx;
}

.group-avatar:first-child {
  margin-left: 0;
}

.group-avatar-shadow {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--td-bg-color-page);
}

.group-avatar-placeholder {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
}

.group-remain {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

.group-countdown {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

/* 双按钮区 */
.action-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx;
}

/* 加购小图标 */
.btn-cart-icon {
  width: 72rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  background: var(--td-bg-color-page);
  flex-shrink: 0;
}

/* 单独购买按钮 */
.btn-solo {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  background: var(--td-bg-color-page);
  min-height: 80rpx;
}

.btn-label-solo {
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 2rpx;
}

.btn-price-solo {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--td-text-color-secondary);
  text-decoration: line-through;
}

/* 发起拼团按钮 */
.btn-group {
  flex: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--primary), #E8453C);
  min-height: 80rpx;
  box-shadow: 0 6rpx 18rpx rgba(255,90,95,.35);
}

.btn-label-group {
  font-size: 22rpx;
  color: rgba(255,255,255,.85);
  margin-bottom: 2rpx;
}

.btn-price-group {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
