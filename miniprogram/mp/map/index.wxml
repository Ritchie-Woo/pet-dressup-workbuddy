<!-- mp/map/index.wxml — 宠物友好地图主页面 -->
<view class="page-brandbar">
  <text class="brand-text">PetMini</text>
</view>

<view class="page-map">
  <!-- 搜索栏 -->
  <view class="map-search-bar">
    <t-search placeholder="搜索地点" bind:submit="onSearch" bind:clear="onSearchClear" />
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="map-cats" scroll-x>
    <view wx:for="{{categories}}" wx:key="value" class="cat-chip {{activeCategory === item.value ? 'active' : ''}} {{item.value === 'all' && !categoryActive ? 'inactive' : ''}}" bindtap="switchCategory" data-val="{{item.value}}">
      <image wx:if="{{item.isImage}}" class="cat-chip-icon" src="{{item.icon}}" mode="aspectFit" />
      <text wx:else class="cat-chip-emoji">{{item.icon}}</text>
      <text class="cat-chip-label">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 地图 -->
  <map id="myMap" class="map-view" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{14}}" markers="{{markers}}" show-location="{{true}}" bindmarkertap="onMarkerTap" bindcallouttap="onMarkerTap" bindregionchange="onRegionChange" />

  <!-- 遛狗开关 -->
  <view class="map-walk-btn {{showWalkBar || walkingActive ? 'active' : ''}}" bindtap="toggleWalkBar">
    <image class="walk-btn-icon" src="/assets/icons/walk.png" mode="aspectFit" />
  </view>

  <!-- 定位按钮 -->
  <view class="map-locate-btn" bindtap="locateMe">
    <t-icon name="location" size="40rpx" color="#333" />
  </view>

  <!-- 投稿按钮（圆形纯图标） -->
  <view class="map-submit-btn" bindtap="goSubmit">
    <t-icon name="edit" size="40rpx" color="#fff" />
  </view>

  <!-- 遛狗宠物选择遮罩（点击关闭） -->
  <view class="walk-mask" wx:if="{{showWalkBar && !walkingActive}}" catchtap="onWalkMaskTap"></view>

  <!-- 遛狗状态栏（点了遛狗图标才显示） -->
  <view class="walk-toggle-bar" wx:if="{{showWalkBar}}">
    <!-- 未遛狗：左侧宠物选择行 + 右侧竖向开始按钮 -->
    <block wx:if="{{!walkingActive}}">
      <view class="walk-privacy-tip">
        <t-icon name="secured" size="28rpx" color="#8c6f4a" />
        <text>开始后仅共享约 200 米模糊位置，附近的人只看到狗狗头像</text>
      </view>
      <view class="walk-pet-row">
        <view wx:if="{{walkPetList.length === 0}}" class="walk-empty-state">
          <text class="walk-empty-title">暂无可遛狗狗</text>
          <text class="walk-empty-desc">请先去穿搭创建一只狗狗档案</text>
        </view>
        <block wx:else>
        <view class="walk-pet-scroll">
          <view wx:for="{{walkPetList}}" wx:key="petId"
            class="walk-pet-chip {{selectedWalkPets.indexOf(item.petId) > -1 ? 'active' : ''}}"
            catchtap="selectWalkPet" data-pet="{{item}}">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="walk-pet-avatar" />
            <text wx:else class="walk-pet-emoji">{{item.species === 'dog' ? '🐶' : '🐱'}}</text>
            <text class="walk-pet-name">{{item.name}}</text>
            <view wx:if="{{selectedWalkPets.indexOf(item.petId) > -1}}" class="walk-pet-check">✓</view>
          </view>
        </view>
        <view class="walk-start-btn-vertical {{selectedWalkPets.length > 0 ? '' : 'disabled'}}" catchtap="startWalkingWithPet">
          <text class="walk-start-text">开</text>
          <text class="walk-start-text">始</text>
          <text class="walk-start-text">{{selectedWalkPets.length > 0 ? '(1)' : ''}}</text>
        </view>
        </block>
      </view>
    </block>
    <!-- 遛狗中：纯状态展示，可点击停止 -->
    <block wx:else>
      <view class="walk-active-bar" catchtap="stopWalking">
        <view class="walk-dot pulsing"></view>
        <text>{{selectedWalkPets.length > 0 ? selectedWalkPets.length + '只狗狗' : '狗狗'}} · 遛狗中 · {{walkDuration}}</text>
      </view>
    </block>
  </view>

  <view class="walk-group-panel" wx:if="{{showWalkGroupPanel && selectedWalkGroup}}">
    <view class="walk-group-header">
      <text class="walk-group-title">附近 {{selectedWalkGroup.count}} 只狗狗</text>
      <view class="walk-group-close" catchtap="closeWalkGroupPanel">×</view>
    </view>
    <view class="walk-group-avatars">
      <block wx:for="{{selectedWalkGroup.pets}}" wx:key="index">
        <image class="walk-group-avatar" src="{{item.avatarUrl || '/assets/icons/walk.png'}}" mode="aspectFill" />
      </block>
    </view>
  </view>

  <!-- 列表完全收起时显示的"把手"小条 -->
  <view class="list-handle {{listSnap === 0 ? 'visible' : ''}}"
        catchtouchstart="onHandleDragStart"
        catchtouchmove="onHandleDragMove"
        catchtouchend="onHandleDragEnd">
    <view class="list-handle-bar"></view>
  </view>

  <!-- 附近地点列表（三段式拖动展开：0 / 30vh / 80vh） -->
  <view class="map-place-list {{places.length === 0 ? 'hidden' : ''}}" wx:if="{{places.length > 0}}"
        style="height: {{_dragVh != null ? _dragVh : (listSnap === 0 ? 0 : listSnap === 1 ? 30 : listSnap === 2 ? 50 : 80)}}vh; transition: {{_dragging ? 'none' : 'height 250ms ease'}};"
        bind:touchstart="onDragStart"
        bind:touchmove="onDragMove"
        bind:touchend="onDragEnd">
    <view class="list-header">
      <text class="list-title">当前区域内地点 ({{places.length}})</text>
      <text class="list-tip" wx:if="{{truncated}}">结果较多，请缩小范围</text>
    </view>
    <view class="list-scroll">
      <view wx:for="{{places}}" wx:key="placeId" id="card-{{item.placeId}}" class="place-mini-card" data-id="{{item.placeId}}" catchtap="onCardTap">
        <image class="place-thumb" src="{{item.images[0] || ''}}" mode="aspectFill" />
        <view class="place-info">
          <text class="place-name">{{item.name}}</text>
          <text class="place-meta">{{categoryLabel(item.category)}} · {{item.distanceText}}</text>
        </view>
        <t-tag wx:if="{{item.rating > 0}}" size="small" variant="light">⭐{{item.rating}}</t-tag>
      </view>
    </view>
  </view>
</view>
