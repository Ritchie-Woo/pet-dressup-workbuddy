<!-- wp/dressup/index.wxml — 三段式布局 -->
<view class="pg-main">
  <!-- Top Bar -->
  <view class="pg-topbar">
    <text class="topbar-brand">PetMini</text>
  </view>

  <!-- Section 1: Pet Selector Row -->
  <view class="section-pets">
    <view class="pet-scroll">
      <view wx:for="{{pets}}" wx:key="petId"
        class="pet-chip {{selectedPetId === item.petId ? 'active' : ''}}"
        catchtap="selectPetChip" data-id="{{item.petId}}">
        <view class="chip-avatar">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" class="chip-img" lazy-load />
          <text wx:else class="chip-emoji">{{item.species === 'dog' ? '🐶' : item.species === 'cat' ? '🐱' : '🐰'}}</text>
        </view>
        <text class="chip-name">{{item.name}}</text>
      </view>
      <view class="pet-chip pet-chip-add" catchtap="goCreatePet">
        <view class="chip-avatar chip-add-icon">+</view>
        <text class="chip-name">新增</text>
      </view>
    </view>
  </view>

  <!-- Section 2: Avatar Display with Picture Frame -->
  <view class="section-avatar">
    <view class="avatar-frame">
      <view wx:if="{{selectedPetId && avatarCreated}}" class="avatar-wrap">
        <canvas type="2d" id="petCanvas" class="pg-canvas" style="width:{{canvasSize}}px;height:{{canvasSize}}px;"
          bindtouchstart="onCanvasTap" />
      </view>
      <view wx:elif="{{selectedPetId}}" class="avatar-empty">
        <text class="ae-icon">✨</text>
        <text class="ae-title">为 {{selectedPetName}} 生成 2D 形象</text>
        <button class="btn-gen" catchtap="createAvatar">🎨 预设形象</button>
        <button class="btn-gen btn-photo" catchtap="photo2Avatar" loading="{{generating}}">📷 从照片生成</button>
      </view>
      <view wx:else class="avatar-empty">
        <text class="ae-icon">🐾</text>
        <text class="ae-title">选择一只宠物开始</text>
      </view>
    </view>
  </view>

  <!-- Section 3: Recommended Pets -->
  <view class="section-recommend">
    <view class="rec-header">
      <text class="rec-title">别人家的</text>
      <view class="rec-refresh" catchtap="refreshRecommend">
        <text class="rec-refresh-icon">⟳</text>
        <text class="rec-refresh-text" wx:if="{{!recommendLoading}}">换一换</text>
        <text class="rec-refresh-dots" wx:else>···</text>
      </view>
    </view>
    <view class="rec-list {{recommendLoading ? 'shuffling' : ''}}">
      <view wx:for="{{recommendPets}}" wx:key="index"
        class="rec-card rec-card-{{index}}"
        id="rec-card-{{index}}"
        style="background:{{item.bg}}"
        catchtap="onRecCardTap"
        data-index="{{index}}"
        hover-class="rec-card-hover">
        <view class="rec-avatar"></view>
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-info">{{item.breed}}</text>
        <text class="rec-like">♥ {{item.likes}}</text>
      </view>
    </view>
  </view>

  <!-- Expand Overlay -->
  <view class="exp-overlay {{expandedCard ? 'exp-overlay-show' : ''}}" catchtap="closeExpand">
    <view class="exp-card {{expandPhase}}"
          style="background:{{expandPhase==='show' ? '#FDF5F0' : expandedCard.bg}};"
          bindtransitionend="onExpCardTransitionEnd"
          catchtap="noop">
      <view class="exp-compact">
        <view class="rec-avatar"></view>
        <text class="rec-name">{{expandedCard.name}}</text>
        <text class="rec-info">{{expandedCard.breed}}</text>
        <text class="rec-like">♥ {{expandedCard.likes}}</text>
      </view>
      <view class="exp-detail">
        <view class="exp-close" catchtap="closeExpand">✕</view>
        <view class="exp-info-bar">
          <view class="exp-info-avatar">
            <text class="exp-info-icon">{{expandedCard.species === 'dog' ? '🐶' : expandedCard.species === 'cat' ? '🐱' : '🐰'}}</text>
          </view>
          <view class="exp-info-main">
            <text class="exp-info-name">{{expandedCard.name}}</text>
            <text class="exp-info-meta">{{expandedCard.species === 'dog' ? '狗狗' : expandedCard.species === 'cat' ? '猫咪' : '其他'}} · {{expandedCard.breed}}</text>
            <view class="exp-info-tags">
              <text class="exp-tag">{{expandedCard.gender}}</text>
              <text class="exp-tag">{{expandedCard.birthday}}</text>
            </view>
          </view>
          <text class="exp-info-likes">♥ {{expandedCard.likes}}</text>
        </view>
        <view class="exp-3d-area">
          <view class="exp-3d-placeholder" wx:if="{{!expandedCard.has3d}}">
            <text class="exp-3d-empty-icon">🧊</text>
            <text class="exp-3d-empty-text">暂无3D形象</text>
          </view>
          <view class="exp-3d-viewer" wx:else>
            <text class="exp-3d-pet">🐶</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
