/* wp/dressup/index.wxss — 三段式 */

.pg-main {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.pg-topbar {
  padding: 20rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  background: var(--bg);
}

.topbar-brand {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -0.5rpx;
}

/* ===== Section 1: Pet Row ===== */
.section-pets {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-tertiary);
}

.pet-scroll {
  white-space: nowrap;
  overflow-x: auto;
  padding: 20rpx 20rpx;
  display: flex;
  align-items: center;
}

.pet-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-right: 32rpx;
  width: 140rpx;
  flex-shrink: 0;
  min-height: 180rpx;
}

.chip-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  flex-shrink: 0;
  position: relative;
}

.pet-chip.active .chip-avatar {
  border-color: var(--primary);
  background: var(--primary-lighter);
}

.chip-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.chip-emoji { font-size: 64rpx; }

.chip-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg);
  box-shadow: var(--shadow);
}

.chip-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.pet-chip.active .chip-name {
  color: var(--primary);
  font-weight: 700;
}

.pet-chip-add .chip-avatar {
  border: 2rpx dashed var(--bg-tertiary);
  background: transparent;
}

.chip-add-icon {
  font-size: 60rpx;
  color: var(--text-secondary);
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== Section 2: Avatar with Picture Frame ===== */
.section-avatar {
  flex: 1;
  display: flex;
  box-sizing: border-box;
}

.avatar-panel {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Metal platinum-gold picture frame — 撑满整个 section */
.avatar-frame {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 内边框 */
  border: 10rpx solid #C8C4BE;
  /* 珍珠白内衬 */
  background: #FAF9F6;
  /* 钻石镶嵌切面：多层 box-shadow spread + inset 模拟宝石切割 */
  box-shadow:
    /* 外侧嵌圈 - 亮银环 */
    0 0 0 3rpx #F0EDE8,
    /* 外侧嵌圈 - 暗银环 */
    0 0 0 6rpx #D8D4CE,
    /* 外层投影 */
    0 4rpx 18rpx rgba(130, 125, 120, 0.4),
    /* ★ 顶部钻石高光 */
    inset 0 6rpx 14rpx rgba(255, 255, 255, 0.95),
    /* ★ 左右侧金属斜切面 */
    inset 6rpx 0 12rpx rgba(220, 215, 210, 0.45),
    inset -6rpx 0 12rpx rgba(180, 175, 170, 0.35),
    /* ★ 底部暗面 */
    inset 0 -5rpx 12rpx rgba(150, 145, 140, 0.3),
    /* 四角内凹暗角 */
    inset 0 0 32rpx rgba(130, 125, 120, 0.07);
  overflow: hidden;
  box-sizing: border-box;
}

.pet-photo-panel {
  padding: 18rpx 24rpx 20rpx;
  background: var(--bg);
  border-top: 1rpx solid var(--bg-tertiary);
  box-sizing: border-box;
}

.pet-photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.visibility-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: var(--font-xs);
  font-weight: 700;
}

.visibility-toggle.public {
  background: var(--secondary-light);
  color: var(--secondary);
}

.visibility-toggle.private {
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.photo-count {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-weight: 700;
}

.photo-strip {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.pet-photo-item,
.pet-photo-add,
.pet-photo-limit {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.pet-photo-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--bg-secondary);
}

.pet-photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-photo-add,
.pet-photo-limit {
  border: 2rpx dashed var(--primary-light);
  background: var(--primary-lighter);
  color: var(--primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.pet-photo-limit {
  border-color: var(--bg-tertiary);
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.pg-canvas {
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  display: block;
}

.avatar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx;
}

.ae-icon { font-size: 80rpx; }
.ae-title { font-size: var(--font-lg); font-weight: 700; color: var(--text); text-align: center; }

.btn-gen {
  margin-top: 12rpx;
  padding: 20rpx 56rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: #fff;
  font-size: var(--font-md);
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255,90,95,0.3);
}

.btn-gen::after { border: none; }
.btn-gen:active { transform: scale(0.96); }

.btn-photo {
  background: var(--secondary);
  box-shadow: 0 6rpx 20rpx rgba(0,166,153,0.3);
}

/* ===== Section 3: Recommend ===== */
.section-recommend {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--bg-tertiary);
}

.rec-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.rec-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text);
}

.rec-refresh {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}

.rec-refresh:active {
  opacity: 0.6;
}

.rec-refresh-icon {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.rec-refresh-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 400;
}

.rec-refresh-dots {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.rec-list {
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  padding: 0 24rpx;
  gap: 16rpx;
}

.rec-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  max-width: 220rpx;
  padding: 32rpx 8rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.rec-card-hover {
  transform: scale(0.95);
  opacity: 0.85;
  transition: all 0.2s;
}

.rec-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  border: 2rpx solid rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.rec-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.rec-avatar-icon {
  font-size: 38rpx;
  line-height: 1;
}

.rec-name {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--primary);
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-info {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-like {
  font-size: var(--font-xs);
  color: var(--primary);
  font-weight: 600;
  min-width: 76rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(255,255,255,0.55);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.rec-like.liked {
  color: #FFFFFF;
  background: var(--primary);
}

.rec-like:active {
  transform: scale(0.94);
}

.rec-like-heart {
  font-size: 24rpx;
  line-height: 1;
}

/* ===== Shuffle Animation ===== */
@keyframes cardShuffle {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  20% { transform: translateY(-12rpx) scale(0.92); opacity: 0.6; }
  50% { transform: translateY(6rpx) scale(1.03); opacity: 0.85; }
  70% { transform: translateY(-4rpx) scale(0.97); opacity: 0.9; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.shuffling .rec-card { animation: cardShuffle 0.7s ease-in-out; }
.shuffling .rec-card-0 { animation-delay: 0s; }
.shuffling .rec-card-1 { animation-delay: 0.12s; }
.shuffling .rec-card-2 { animation-delay: 0.24s; }

/* ===== Expand Overlay ===== */
.exp-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: background 0.3s;
}

.exp-overlay-show {
  background: rgba(90, 55, 40, 0.4);
  pointer-events: auto;
}

.exp-card {
  width: 680rpx;
  height: 860rpx;
  border-radius: var(--radius);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: scale(0.3);
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.exp-card.expand { transform: scale(1); opacity: 1; }
.exp-card.show { transform: scale(1); opacity: 1; border-radius: var(--radius); justify-content: flex-start; }

.exp-compact {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 48rpx 32rpx;
  opacity: 1;
  transition: opacity 0.25s;
}

.exp-card.show .exp-compact { opacity: 0; pointer-events: none; position: absolute; }

.exp-compact .rec-name { font-size: var(--font-lg); }
.exp-compact .rec-info { font-size: var(--font-sm); }
.exp-compact .rec-like { font-size: var(--font-sm); }

.exp-detail {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  transition: opacity 0.3s 0.15s;
  pointer-events: none;
}

.exp-card.show .exp-detail { opacity: 1; pointer-events: auto; position: relative; }

.exp-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(160, 120, 100, 0.15);
  color: #5D4037;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.exp-3d-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8EDE4;
  border-top: 1rpx solid #EDE0D5;
}

.exp-3d-placeholder { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.exp-3d-empty-icon { font-size: 80rpx; opacity: 0.5; }
.exp-3d-empty-text { font-size: var(--font-md); color: #B8A090; font-weight: 500; }

.exp-3d-viewer { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.exp-3d-pet { font-size: 280rpx; filter: drop-shadow(0 8rpx 24rpx rgba(160, 120, 100, 0.2)); }

.exp-info-bar {
  height: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.exp-info-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(160, 120, 100, 0.1);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  overflow: hidden;
}

.exp-info-icon { font-size: 48rpx; }
.exp-info-img { width: 100%; height: 100%; border-radius: 50%; display: block; }

.exp-info-main { display: flex; flex-direction: column; gap: 4rpx; flex: 1; min-width: 0; }
.exp-info-name { font-size: var(--font-lg); font-weight: 700; color: #5D4037; }
.exp-info-meta { font-size: var(--font-xs); color: #A1887F; }

.exp-info-tags { display: flex; flex-direction: row; gap: 12rpx; margin-top: 4rpx; }
.exp-tag {
  font-size: 20rpx; color: #8D6E63; padding: 2rpx 12rpx;
  border-radius: var(--radius-pill); background: rgba(160, 120, 100, 0.08);
}

.exp-info-likes {
  font-size: var(--font-md);
  color: #FF5A5F;
  font-weight: 700;
  flex-shrink: 0;
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 90, 95, 0.1);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.exp-info-likes.liked {
  color: #FFFFFF;
  background: #FF5A5F;
}
