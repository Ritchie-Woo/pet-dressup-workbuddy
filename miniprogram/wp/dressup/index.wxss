/* wp/dressup/index.wxss — 三段式 */

.pg-main {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

.pg-topbar {
  padding: 20rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  background: var(--bg);
}

.topbar-brand {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -0.5rpx;
}

/* ===== Section 1: Pet Row ===== */
.section-pets {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-tertiary);
}

.pet-scroll {
  white-space: nowrap;
  overflow-x: auto;
  padding: 20rpx 20rpx;
  display: flex;
  align-items: center;
}

.pet-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-right: 32rpx;
  width: 140rpx;
  flex-shrink: 0;
  min-height: 180rpx;
}

.chip-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  flex-shrink: 0;
}

.pet-chip.active .chip-avatar {
  border-color: var(--primary);
  background: var(--primary-lighter);
}

.chip-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.chip-emoji { font-size: 64rpx; }

.chip-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.pet-chip.active .chip-name {
  color: var(--primary);
  font-weight: 700;
}

.pet-chip-add .chip-avatar {
  border: 2rpx dashed var(--bg-tertiary);
  background: transparent;
}

.chip-add-icon {
  font-size: 60rpx;
  color: var(--text-secondary);
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== Section 2: Avatar ===== */
.section-avatar {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FFF5F5 0%, var(--bg) 100%);
  min-height: 500rpx;
}

.avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pg-canvas {
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  display: block;
}

.avatar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx;
}

.ae-icon { font-size: 80rpx; }
.ae-title { font-size: var(--font-lg); font-weight: 700; color: var(--text); text-align: center; }

.btn-gen {
  margin-top: 12rpx;
  padding: 20rpx 56rpx;
  border: none;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: #fff;
  font-size: var(--font-md);
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255,90,95,0.3);
}

.btn-gen::after { border: none; }
.btn-gen:active { transform: scale(0.96); }

.btn-photo {
  background: var(--secondary);
  box-shadow: 0 6rpx 20rpx rgba(0,166,153,0.3);
}

/* ===== Section 3: Recommend ===== */
.section-recommend {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--bg-tertiary);
}

.rec-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--text);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.rec-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.rec-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 180rpx;
  padding: 32rpx 16rpx;
  margin-right: 16rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.rec-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  border: 2rpx solid rgba(255,255,255,0.6);
}

.rec-name {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--primary);
}

.rec-info {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.rec-like {
  font-size: var(--font-xs);
  color: var(--primary);
  font-weight: 600;
}
