{
  "pages": [
    "common/login/index",
    "wp/dressup/index",
    "wp/avatar/index",
    "wp/share/index",
    "wp/deskpet/index",
    "mp/map/index",
    "mp/place/index",
    "my/index",
    "common/pet/list/index",
    "common/pet/create/index",
    "common/pet/detail/index",
    "common/address/list/index",
    "common/address/edit/index"
  ],
  "subPackages": [
    {
      "root": "gb",
      "name": "subpackage-gb",
      "pages": [
        "list/index",
        "detail/index",
        "cart/index",
        "order/list/index",
        "order/detail/index",
        "groupbuy/index/index",
        "groupbuy/product/list/index",
        "groupbuy/product/edit/index",
        "groupbuy/order/list/index",
        "groupbuy/order/detail/index"
      ]
    },
    {
      "root": "mbti",
      "name": "subpackage-mbti",
      "pages": [
        "test/index",
        "card/index"
      ]
    }
  ],
  "window": {
    "navigationStyle": "custom",
    "backgroundTextStyle": "dark",
    "backgroundColor": "#FFF8F0"
  },
  "tabBar": {
    "custom": false,
    "color": "#999999",
    "selectedColor": "#FF5A5F",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "wp/dressup/index",
        "text": "穿搭",
        "iconPath": "images/tab/wp.png",
        "selectedIconPath": "images/tab/wp-active.png"
      },
      {
        "pagePath": "mp/map/index",
        "text": "地图",
        "iconPath": "images/tab/mp.png",
        "selectedIconPath": "images/tab/mp-active.png"
      }
    ]
  },
  "usingComponents": {
    "t-icon": "tdesign-miniprogram/icon/icon",
    "t-button": "tdesign-miniprogram/button/button",
    "t-loading": "tdesign-miniprogram/loading/loading",
    "t-toast": "tdesign-miniprogram/toast/toast",
    "t-empty": "tdesign-miniprogram/empty/empty",
    "t-popup": "tdesign-miniprogram/popup/popup",
    "t-tag": "tdesign-miniprogram/tag/tag",
    "pet-widget": "/components/pet-widget/index"
  },
  "networkTimeout": {
    "request": 15000,
    "connectSocket": 15000,
    "uploadFile": 30000,
    "downloadFile": 30000
  },
  "permission": {
    "scope.userLocation": {
      "desc": "需要获取您的位置以展示附近宠物友好场所"
    }
  },
  "requiredPrivateInfos": ["getLocation", "chooseLocation"],
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "renderer": "skyline",
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "defaultContentBox": true,
      "sdkVersionBegin": "3.7.0",
      "sdkVersionEnd": "99.0.0"
    }
  },
  "componentFramework": "glass-easel"
}
