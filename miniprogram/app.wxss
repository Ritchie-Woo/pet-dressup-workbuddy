/* PetMini · Airbnb Design System — 全局样式 */
/* 设计令牌来源: Airbnb Design Language · 提取自 PawAI mockup */

/* ===== 引入 TDesign 样式 ===== */
@import '/miniprogram_npm/tdesign-miniprogram/common/style/index.wxss';

/* ===== 全局 CSS 变量（Airbnb 设计系统） ===== */
page {
  /* ── 品牌色 ── */
  --td-brand-color: #FF5A5F;
  --td-brand-color-light: #FFE5E3;
  --td-brand-color-lighter: #FFF5F5;
  --td-warning-color: #FF5A5F;
  --td-success-color: #00A699;
  --td-error-color: #FF5A5F;

  /* ── 文字 ── */
  --td-text-color-primary: #222222;
  --td-text-color-secondary: #717171;
  --td-text-color-placeholder: #B0B0B0;
  --td-bg-color-page: #F5F5F5;
  --td-bg-color-container: #FFFFFF;
  --td-font-size-base: 26rpx;
  --td-font-size-title: 30rpx;

  /* ── 品牌色 ── */
  --primary: #FF5A5F;
  --primary-light: #FFE5E3;
  --primary-lighter: #FFF5F5;
  --secondary: #00A699;
  --secondary-light: #E8F8F6;
  --secondary-lighter: #F0FAF9;

  /* ── 中性色 ── */
  --bg: #FFFFFF;
  --bg-secondary: #F7F7F7;
  --bg-tertiary: #EBEBEB;
  --body-bg: #F5F5F5;

  /* ── 文字 ── */
  --text: #222222;
  --text-secondary: #717171;
  --text-on-primary: #FFFFFF;

  /* ── 兼容旧变量名 ── */
  --color-primary: #FF5A5F;
  --color-primary-light: #FFE5E3;
  --color-bg-page: #F5F5F5;
  --color-bg-card: #FFFFFF;
  --color-text-main: #222222;
  --color-text-sub: #717171;
  --color-text-hint: #B0B0B0;
  --color-border: #EBEBEB;
  --color-shadow: rgba(0, 0, 0, 0.08);

  /* ── 间距（Airbnb 风格：更大留白） ── */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* ── 圆角 ── */
  --radius: 24rpx;
  --radius-xl: 32rpx;
  --radius-pill: 40rpx;

  /* ── 阴影 ── */
  --shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);

  /* ── 字号 ── */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 26rpx;
  --font-lg: 30rpx;
  --font-xl: 34rpx;
  --font-xxl: 44rpx;

  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-md);
  color: var(--text);
  background-color: var(--body-bg);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ===== 工具类 ===== */

/* Flex 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-align-center {
  display: flex;
  align-items: center;
}

/* 文字 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-main { color: var(--text); }
.text-sub { color: var(--text-secondary); }
.text-hint { color: var(--color-text-hint); }
.text-primary { color: var(--primary); }
.text-xs { font-size: var(--font-xs); }
.text-sm { font-size: var(--font-sm); }
.text-md { font-size: var(--font-md); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }
.text-bold { font-weight: 600; }

/* 间距 */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.pt-sm { padding-top: var(--spacing-sm); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* 通用卡片 */
.card {
  background: var(--bg);
  border-radius: var(--radius);
  padding: var(--spacing-md);
  margin: var(--spacing-sm);
  box-shadow: var(--shadow);
  border: 1rpx solid var(--bg-tertiary);
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 单行省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 双行省略 */
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 共享品牌顶栏（所有自定义导航栏页面复用） ===== */
.page-brandbar {
  padding: 20rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  background: var(--bg);
}
.brand-text {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: -0.5rpx;
}
