/* pet-wb 全局样式 */

/* ===== 引入 TDesign 样式 ===== */
@import '/miniprogram_npm/tdesign-miniprogram/common/index.wxss';

/* ===== 全局 CSS 变量（TDesign 主题色覆盖） ===== */
page {
  --td-brand-color: #FF8C00;
  --td-brand-color-light: #FFF0E0;
  --td-brand-color-lighter: #FFF8F0;
  --td-warning-color: #FF8C00;
  --td-success-color: #07C160;
  --td-error-color: #FF4D4F;
  --td-text-color-primary: #333333;
  --td-text-color-secondary: #666666;
  --td-text-color-placeholder: #999999;
  --td-bg-color-page: #FFF8F0;
  --td-bg-color-container: #FFFFFF;
  --td-font-size-base: 28rpx;
  --td-font-size-title: 32rpx;

  /* 自定义颜色 */
  --color-primary: #FF8C00;
  --color-primary-light: #FFF0E0;
  --color-bg-page: #FFF8F0;
  --color-bg-card: #FFFFFF;
  --color-text-main: #333333;
  --color-text-sub: #666666;
  --color-text-hint: #999999;
  --color-border: #F0F0F0;
  --color-shadow: rgba(0, 0, 0, 0.05);

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 999rpx;

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-main);
  background-color: var(--color-bg-page);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ===== 工具类 ===== */

/* Flex 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-align-center {
  display: flex;
  align-items: center;
}

/* 文字 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-main { color: var(--color-text-main); }
.text-sub { color: var(--color-text-sub); }
.text-hint { color: var(--color-text-hint); }
.text-primary { color: var(--color-primary); }
.text-xs { font-size: var(--font-xs); }
.text-sm { font-size: var(--font-sm); }
.text-md { font-size: var(--font-md); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }
.text-bold { font-weight: 600; }

/* 间距 */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.pt-sm { padding-top: var(--spacing-sm); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* 通用卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin: var(--spacing-sm);
  box-shadow: 0 2rpx 12rpx var(--color-shadow);
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 单行省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 双行省略 */
.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
