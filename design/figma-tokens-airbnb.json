{
  "$schema": "https://raw.githubusercontent.com/amzn/style-dictionary/main/figma-tokens.schema.json",
  "design-system": "Airbnb 原版",
  "project": "PetMini",
  "source": "PawAI mockup-airbnb.html",
  "viewport": "375pt",
  "tokens": {
    "color": {
      "brand": {
        "primary": {
          "value": "#FF5A5F",
          "type": "color",
          "description": "主色 — 按钮/品牌/标签/星级"
        },
        "primaryLight": {
          "value": "#FFE5E3",
          "type": "color",
          "description": "Hero 渐变起点 / 浅色背景"
        },
        "primaryLighter": {
          "value": "#FFF5F5",
          "type": "color",
          "description": "Feature 卡片奇数位底色"
        },
        "secondary": {
          "value": "#00A699",
          "type": "color",
          "description": "辅色 — 成功态 / Feature 交替"
        },
        "secondaryLight": {
          "value": "#E8F8F6",
          "type": "color",
          "description": "浅青绿背景"
        },
        "secondaryLighter": {
          "value": "#F0FAF9",
          "type": "color",
          "description": "Feature 卡片偶数位底色"
        }
      },
      "bg": {
        "page": { "value": "#FFFFFF", "type": "color" },
        "secondary": { "value": "#F7F7F7", "type": "color" },
        "tertiary": { "value": "#EBEBEB", "type": "color", "description": "边框/分割/禁用" },
        "body": { "value": "#F5F5F5", "type": "color", "description": "外层页面底色" }
      },
      "text": {
        "primary": { "value": "#222222", "type": "color" },
        "secondary": { "value": "#717171", "type": "color" },
        "onPrimary": { "value": "#FFFFFF", "type": "color" },
        "heroOverlay": { "value": "rgba(0,0,0,0.5)", "type": "color" }
      },
      "gradient": {
        "hero": {
          "value": "linear-gradient(135deg, #FFE5E3 0%, #FFD1CF 50%, #FFB8B3 100%)",
          "type": "color",
          "description": "Hero Banner 专用渐变"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "ui": {
          "value": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"PingFang SC\", sans-serif",
          "type": "fontFamilies"
        }
      },
      "fontSize": {
        "caption": { "value": "10px", "type": "fontSizes", "description": "标签/Tab" },
        "bodySm": { "value": "12px", "type": "fontSizes", "description": "辅助信息" },
        "body": { "value": "13px", "type": "fontSizes", "description": "正文/卡片标题" },
        "bodyLg": { "value": "15px", "type": "fontSizes", "description": "区块标题" },
        "title": { "value": "18px", "type": "fontSizes", "description": "Hero 标题" },
        "headline": { "value": "20px", "type": "fontSizes", "description": "导航品牌名" }
      },
      "fontWeight": {
        "body": { "value": "400", "type": "fontWeights" },
        "semibold": { "value": "600", "type": "fontWeights" },
        "bold": { "value": "700", "type": "fontWeights", "description": "标题/按钮" },
        "extrabold": { "value": "800", "type": "fontWeights", "description": "品牌名/大标题" }
      },
      "letterSpacing": {
        "headline": { "value": "-0.5px", "type": "letterSpacing" }
      }
    },
    "spacing": {
      "xs": { "value": "8px", "type": "spacing" },
      "sm": { "value": "12px", "type": "spacing", "description": "Grid gap" },
      "md": { "value": "16px", "type": "spacing" },
      "lg": { "value": "20px", "type": "spacing", "description": "Section padding / Body margin" },
      "xl": { "value": "24px", "type": "spacing" }
    },
    "borderRadius": {
      "default": { "value": "12px", "type": "borderRadius", "description": "卡片/图片" },
      "xl": { "value": "16px", "type": "borderRadius", "description": "Hero/弹窗" },
      "pill": { "value": "20px", "type": "borderRadius", "description": "按钮/标签" },
      "circle": { "value": "50%", "type": "borderRadius" }
    },
    "shadow": {
      "default": { "value": "0 4px 12px rgba(0,0,0,0.08)", "type": "boxShadow" },
      "lg": { "value": "0 6px 20px rgba(0,0,0,0.12)", "type": "boxShadow" }
    },
    "border": {
      "card": { "value": "0.5px solid #EBEBEB", "type": "border" },
      "tabbar": { "value": "0.5px solid #EBEBEB", "type": "border" }
    }
  }
}
